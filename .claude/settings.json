{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make up)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make check)",
      "Bash(make dbt-parse)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)"
    ],
    "ask": [
      "Bash(make seed *)",
      "Bash(make reseed *)",
      "Bash(make db-reset *)",
      "Bash(make clean-raw *)",
      "Bash(make snowflake-init *)",
      "Bash(make dbt-full-refresh *)",
      "Bash(uv run seed *)",
      "Bash(uv run clean-ingest *)",
      "Bash(uv run python -m retail_pulse.ingestion.clean *)",
      "Bash(git push * main)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(/.env)",
      "Read(/.dlt/secrets.toml)",
      "Read(/dbt/profiles.yml)",
      "Read(/.snowflake/**)",
      "Read(*.p8)",
      "Read(*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_after_edit.py\""
          }
        ]
      }
    ]
  }
}
