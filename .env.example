# Sao chép thành .env rồi điền giá trị thật. File .env nằm trong .gitignore: KHÔNG commit.
# Không phải biến nào cũng cần ngay từ đầu: nhóm PostgreSQL từ phase 1, nhóm Snowflake từ phase 3.

# --- PostgreSQL OLTP (Docker Compose và code Python đều đọc) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=retail
PG_PASSWORD=change-me
PG_DB=retail_oltp

# --- Snowflake: dbt, Dagster và Great Expectations ---
# Account identifier dạng ORGNAME-ACCOUNTNAME. Lấy bằng câu lệnh trong Snowsight:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
# Private key của user DBT_TRANSFORMER, do `make snowflake-init` tạo ra.
# Dùng đường dẫn TUYỆT ĐỐI: dbt chạy từ thư mục dbt/ còn Great Expectations chạy từ gốc repo.
DBT_PRIVATE_KEY_PATH=/duong/dan/tuyet/doi/retail-pulse/.snowflake/dbt_transformer.p8

# --- Chỉ dùng khi chạy `make snowflake-init` (tài khoản ACCOUNTADMIN) ---
# Xong việc khởi tạo thì có thể xóa hai dòng này khỏi .env.
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PASSWORD=

# --- Preset (phase 7): mật khẩu của user PRESET_READER, role chỉ đọc schema MARTS ---
PRESET_READER_PASSWORD=

# --- Tùy chọn ---
# Giữ lịch sử chạy và trạng thái lịch của Dagster khi tắt máy (thư mục này đã được .gitignore):
# DAGSTER_HOME=/duong/dan/tuyet/doi/retail-pulse/.dagster_home
# Thư mục chứa profiles.yml của dbt (mặc định ~/.dbt):
# DBT_PROFILES_DIR=
