# Copy to .env and fill in real values. .env is in .gitignore: do NOT commit it.
# Not every variable is needed up front: PostgreSQL from phase 1, Snowflake from phase 3.

# --- PostgreSQL OLTP (read by both Docker Compose and the Python code) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=retail
PG_PASSWORD=change-me
PG_DB=retail_oltp

# --- Snowflake: dbt, Dagster and Great Expectations ---
# Account identifier in ORGNAME-ACCOUNTNAME form. Get it with this query in Snowsight:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
# Private key of the DBT_TRANSFORMER user, created by `make snowflake-init`.
# Use an ABSOLUTE path: dbt runs from dbt/ while Great Expectations runs from the repo root.
DBT_PRIVATE_KEY_PATH=/absolute/path/to/retail-pulse/.snowflake/dbt_transformer.p8

# --- Only for `make snowflake-init` (ACCOUNTADMIN account) ---
# After setup you can remove these two lines from .env.
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PASSWORD=

# --- Preset (phase 7): password of the PRESET_READER user, a read-only role on schema MARTS ---
PRESET_READER_PASSWORD=

# --- Optional ---
# Keep Dagster run history and schedule state across restarts (this folder is gitignored):
# DAGSTER_HOME=/absolute/path/to/retail-pulse/.dagster_home
# Folder holding dbt's profiles.yml (default ~/.dbt):
# DBT_PROFILES_DIR=
