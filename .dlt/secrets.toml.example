# Copy to .dlt/secrets.toml and fill in real values.
# .dlt/secrets.toml is in .gitignore: do NOT commit it. Only this .example file is committed.

[destination.snowflake.credentials]
# Account identifier. Get it with this query in Snowsight:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
host = "ORGNAME-ACCOUNTNAME"
database = "RETAIL_PULSE"
username = "DLT_LOADER"
warehouse = "RETAIL_WH"
role = "LOADER"
# Private key of DLT_LOADER (.snowflake/dlt_loader.p8, created by `make snowflake-init`),
# as a base64 string. Or drop this line and set private_key_path to the PEM file:
private_key = "<base64 string of the private key>"
# private_key_path = "/absolute/path/to/retail-pulse/.snowflake/dlt_loader.p8"
