# Sao chép thành .dlt/secrets.toml rồi điền giá trị thật.
# File .dlt/secrets.toml nằm trong .gitignore: KHÔNG commit. Chỉ file .example này được commit.

[destination.snowflake.credentials]
# Account identifier. Lấy bằng câu lệnh trong Snowsight:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
host = "ORGNAME-ACCOUNTNAME"
database = "RETAIL_PULSE"
username = "DLT_LOADER"
warehouse = "RETAIL_WH"
role = "LOADER"
# Private key của DLT_LOADER (.snowflake/dlt_loader.p8, do `make snowflake-init` tạo ra),
# dạng chuỗi base64. Hoặc bỏ dòng này và dùng private_key_path trỏ tới file PEM:
private_key = "<chuỗi base64 của private key>"
# private_key_path = "/duong/dan/tuyet/doi/retail-pulse/.snowflake/dlt_loader.p8"
